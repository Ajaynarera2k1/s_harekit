NODE_ENV=production
PORT=8080
DB_URL=mongodb+srv://<username>:<password>@<cluster-url>/sharekit?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_FILE_SECRET=replace-with-a-second-long-random-secret
SERVER=https://your-render-service.onrender.com
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-email-app-password
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

